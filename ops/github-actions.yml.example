# The cloud escape hatch. Copy to .github/workflows/refresh.yml when you want
# the refresh to run whether or not the laptop is awake.
#
# Nothing in scripts/ needs to change: the pipeline takes its paths from
# AKL_ROOT / AKL_RAW_DIR / AKL_DB and has no macOS-specific code. Only this
# wrapper and where the outputs land are different.
#
# The thing to decide before switching: state has to live somewhere. The
# append-only history is in data/auckland.duckdb (~100 MB), which is too big to
# commit each month. Pick one:
#   a) cache/restore the .duckdb between runs (simplest, but a cache eviction
#      silently loses history — the raw snapshots would need keeping too);
#   b) push data/raw snapshots to object storage (R2/S3) and rebuild the db
#      from them each run — raw stays the source of truth, which is the model
#      this project already follows;
#   c) point AKL_DB at a hosted Postgres/MotherDuck and drop the file entirely.
# (b) is the one that matches the current design.

name: monthly refresh

on:
  schedule:
    - cron: "10 18 1 * *"     # 06:10 NZST on the 2nd (UTC+12)
  workflow_dispatch:
    inputs:
      force:
        description: "sources to force (space separated, or 'all')"
        default: ""

jobs:
  refresh:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - run: pip install duckdb

      # (b): pull the last validated raw snapshot, rebuild everything from it
      - name: Restore raw snapshot
        run: |
          mkdir -p data/raw
          aws s3 sync s3://$BUCKET/raw data/raw --no-progress
        env:
          BUCKET: ${{ secrets.SNAPSHOT_BUCKET }}
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}

      - name: Run pipeline
        run: |
          python3 scripts/pipeline.py run --trigger schedule \
            ${{ inputs.force && format('--force {0}', inputs.force) || '' }}

      - name: Publish raw snapshot + page
        run: |
          aws s3 sync data/raw s3://$BUCKET/raw --no-progress
          aws s3 cp heatmap.html s3://$BUCKET/heatmap.html
        env:
          BUCKET: ${{ secrets.SNAPSHOT_BUCKET }}
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}

      - name: Upload run log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: pipeline-log
          path: logs/pipeline.jsonl
